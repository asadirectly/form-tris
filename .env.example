# copy this file to .env and fill it in
PORT=3000
APP_URL=http://localhost:5173
SESSION_SECRET=put-a-long-random-string-here

# the formbar api server and the formbar website (where /oauth lives)
# check these against your formbar instance, they may be the same address
FORMBAR_API_URL=https://formbar.yorktechapps.com
FORMBAR_CLIENT_URL=https://formbar.yorktechapps.com
